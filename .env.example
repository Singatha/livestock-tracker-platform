DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_DB=livestock_tracker
POSTGRES_USER=livestock
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
DJANGO_ATTACHMENT_MAX_SIZE=10485760

# Keep the console backend locally. Configure SMTP in deployed environments.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Flockwise <noreply@example.com>
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
FRONTEND_BASE_URL=http://localhost:3000
